# Postgres (Neon), com ?sslmode=require
DATABASE_URL=

# 32 bytes em base64. Cifra as credenciais de gateway guardadas no banco.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# Para onde a venda vai. RRTrack -> Integracoes -> Webhooks -> Credenciais de API.
RRTRACK_BASE=https://www.rrtrack.com.br
RRTRACK_TOKEN=

# Cadeado provisório do painel. Sem ele o painel responde 404.
PAINEL_TOKEN=

# Segredo da URL de webhook do aplicativo Appmax.
APPMAX_WEBHOOK_SECRET=

APPMAX_APP_ID=
APPMAX_APP_UUID=
