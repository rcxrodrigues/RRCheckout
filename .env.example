# Postgres (Neon), com ?sslmode=require
DATABASE_URL=

# 32 bytes em base64. Cifra as credenciais de gateway guardadas no banco.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# Base do RRTrack. O TOKEN nao vem daqui: ele e por loja, cifrado no banco.
RRTRACK_BASE=https://www.rrtrack.com.br


# Segredo da URL de webhook do aplicativo Appmax.
APPMAX_WEBHOOK_SECRET=

APPMAX_APP_ID=
APPMAX_APP_UUID=

PLATAFORMA_BASE=

APPMAX_APP_CLIENT_ID=
APPMAX_APP_CLIENT_SECRET=

# ---------------------------------------------------------------- Vercel
#
# Publicar o domínio do lojista é passo NOSSO: o projeto é da nossa conta, e
# sem isto o CNAME dele aponta para um lugar que não reconhece o endereço — o
# certificado nunca sai e ninguém descobre por quê.
#
# O token sai de vercel.com → Account Settings → Tokens, com escopo do time
# dono do projeto. O id do projeto está em Project Settings → General.
# VERCEL_TEAM_ID só é necessário quando o projeto vive num time, não na conta
# pessoal — está na mesma tela, como "Team ID".
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
